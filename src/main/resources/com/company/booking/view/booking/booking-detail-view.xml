<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://bookingDetailView.title"
      focusComponent="form">
    <data>
        <instance id="bookingDc"
                  class="com.company.booking.entity.Booking">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_instance_name"/>
                <property name="room" fetchPlan="_instance_name"/>
                <property name="desk" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="bookingDl"/>
        </instance>
        <!-- floor of the selected room or desk; no loader - set by the controller when the place changes -->
        <instance id="floorPlanDc"
                  class="com.company.booking.entity.Floor">
            <fetchPlan extends="_instance_name">
                <property name="plan"/>
            </fetchPlan>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="bookingDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="userField" property="user">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="roomField" property="room">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="deskField" property="desk">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <dateTimePicker id="startTimeField" property="startTime"/>
            <dateTimePicker id="endTimeField" property="endTime"/>
            <select id="statusField" property="status"/>
            <textArea id="purposeField" property="purpose" height="9.5em" colspan="2"/>
        </formLayout>
        <h4 id="floorPlanHeader" text="msg://floorPlanHeader.text"/>
        <span id="noFloorPlanText" text="msg://noFloorPlanText.text"/>
        <image id="floorPlanImage" dataContainer="floorPlanDc" property="plan"
               alternateText="msg://floorPlanImage.alternateText"
               maxWidth="100%" maxHeight="24rem" visible="false"/>
        <button id="downloadPlanButton" text="msg://downloadPlanButton.text" enabled="false"/>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
